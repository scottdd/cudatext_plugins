[info]
version=0.7.1
title=Tab Menu
desc=Tab context menu: file info, reveal, folder, terminal, reload, save copy, duplicate, delete, HTML export
type=cudatext-plugin
subdir=cuda_tabmenu
homepage=https://github.com/scottdd/cudatext_plugins/tree/main/cuda-tabmenu
api=1.0.300

[item1]
section=events
events=on_start,on_tab_menu

[item10]
section=commands
caption=Tab Menu\File &Info...
hotkey=Ctrl+Shift+Alt+I
method=cmd_file_info

[item11]
section=commands
caption=Tab Menu\&Reveal in File Manager
method=cmd_reveal

[item12]
section=commands
caption=Tab Menu\Open &Folder
method=cmd_open_folder

[item13]
section=commands
caption=Tab Menu\Open &Terminal Here
method=cmd_open_terminal

[item14]
section=commands
caption=Tab Menu\Reo&pen / Reload from Disk
method=cmd_reload

[item15]
section=commands
caption=Tab Menu\&Save a Copy As...
method=cmd_save_copy

[item16]
section=commands
caption=Tab Menu\D&uplicate File
method=cmd_duplicate

[item17]
section=commands
caption=Tab Menu\Close and &Delete File...
method=cmd_close_delete

[item18]
section=commands
caption=Tab Menu\&Export to HTML...
method=cmd_export_html
