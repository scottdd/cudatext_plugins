[info]
version=0.1.1
title=Addons Update
desc=Auto-check and silently update installed CudaText add-ons on startup and on a timer (default every 12 hours)
type=cudatext-plugin
subdir=cuda_addon_update
homepage=https://github.com/scottdd/cudatext_plugins/tree/main/addon_update
api=1.0.300

[item1]
section=events
events=on_start

[item10]
section=commands
caption=Addons Update\Check now
method=check_now

[item11]
section=commands
caption=Addons Update\Config...
method=config
menu=op

[item12]
section=commands
caption=Addons Update\Show last result
method=show_last_result

[item13]
section=commands
caption=Addons Update\Reload config
method=reload_config
